; Overwolf installer work for a Tauri NSIS installer (CONTRACT I.6).
; Generated by tauri_plugin_overwolf::build::write_nsis_installer_hooks;
; point bundle.windows.nsis.installerHooks at this file. Regenerate it when
; the app name, author, version or uid changes.
;
; uid:      @UID@
; app name: @PRODUCT_NAME_COMMENT@

!macro NSIS_HOOK_POSTINSTALL
  ; Matches ow-electron (observed): the install record Overwolf reads.
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "InstallLocation" "$INSTDIR"
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "version" "@VERSION@"
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "ShortcutName" "${MAINBINARYNAME}.exe"
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; A real uninstall only: Tauri's updater runs the uninstaller with /UPDATE,
  ; which sets $UpdateMode, and an update must keep consent and app state.
  ${If} $UpdateMode <> 1
    RMDir /r "$APPDATA\ow-electron\@UID@"
    DeleteRegKey SHCTX "Software\OverwolfElectron\@UID@"

    ; The machine ids the runtime writes (E.4); empty when it never ran.
    ReadRegStr $R0 HKCU "Software\OverwolfElectron" "MUID"
    ReadRegStr $R1 HKCU "Software\OverwolfPersist" "MUIDV2"
    ; Counter @COUNTER_NAME@ (App Uninstalls). NSIS has no HTTPS client of
    ; its own: use curl.exe (Windows 10 1803 and later), else PowerShell.
    StrCpy $R2 "@COUNTER_URL_PREFIX@&MUID=$R0&MUIDV2=$R1&Extra=@EXTRA@"
    ${If} ${FileExists} "$SYSDIR\curl.exe"
      nsExec::Exec '"$SYSDIR\curl.exe" -s -o NUL -m 5 "$R2"'
    ${Else}
      nsExec::Exec 'powershell.exe -NoProfile -NonInteractive -Command "try { Invoke-WebRequest -UseBasicParsing -TimeoutSec 5 -Uri $\'$R2$\' | Out-Null } catch {}"'
    ${EndIf}
    Pop $R2

    ; Overwolf's elevated helper is not removed: no package runtime installs
    ; it while ow-tauri hosts only the ads system (CONTRACT H).
  ${EndIf}
!macroend
