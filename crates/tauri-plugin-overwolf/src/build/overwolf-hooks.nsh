; Overwolf installer work for a Tauri NSIS installer (CONTRACT I.6).
; Generated by tauri_plugin_overwolf::build::run from the merged Tauri
; configuration on every build; do not edit.
;
; uid:      @UID@
; app name: @PRODUCT_NAME_COMMENT@
; version:  @VERSION_COMMENT@
;
; Point bundle.windows.nsis.installerHooks at installer-hooks.nsh next to
; this file, or !include this file from your own hooks file and insert
; OW_TAURI_HOOK_POSTINSTALL / OW_TAURI_HOOK_POSTUNINSTALL from your
; NSIS_HOOK_POSTINSTALL / NSIS_HOOK_POSTUNINSTALL.

!ifndef OW_TAURI_OVERWOLF_HOOKS_NSH
!define OW_TAURI_OVERWOLF_HOOKS_NSH

; SHCTX and $APPDATA as the install mode sets them. Tauri's uninstaller may
; have switched to the per-user context before the hook (when it deletes the
; app data), so the install record's context is set again here.
!macro OW_TAURI_INSTALL_CONTEXT
  !if "${INSTALLMODE}" == "perMachine"
    SetShellVarContext all
  !else if "${INSTALLMODE}" == "both"
    ${If} $MultiUser.InstallMode == "AllUsers"
      SetShellVarContext all
    ${Else}
      SetShellVarContext current
    ${EndIf}
  !else
    SetShellVarContext current
  !endif
!macroend

; The install record Overwolf reads (matches ow-electron, observed). It is
; written on updates too (Tauri's /UPDATE), as the Overwolf builder's
; install section runs on every install, so "version" follows the
; installed release; the other values do not change.
!macro OW_TAURI_HOOK_POSTINSTALL
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "InstallLocation" "$INSTDIR"
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "version" "@VERSION@"
  WriteRegStr SHCTX "Software\OverwolfElectron\@UID@" "ShortcutName" "${MAINBINARYNAME}.exe"
!macroend

; A real uninstall only: the update client starts the installer with
; /UPDATE, Tauri's template then sets $UpdateMode, and an update must keep
; consent and app state.
!macro OW_TAURI_HOOK_POSTUNINSTALL
  ${If} $UpdateMode <> 1
    !insertmacro OW_TAURI_INSTALL_CONTEXT
    DeleteRegKey SHCTX "Software\OverwolfElectron\@UID@"
    ; The state folder is per user (%APPDATA% of the user who ran the app),
    ; also for a per-machine install, whose context would point $APPDATA at
    ; ProgramData.
    SetShellVarContext current
    RMDir /r "$APPDATA\ow-electron\@UID@"
    !insertmacro OW_TAURI_INSTALL_CONTEXT

    ; The machine ids the runtime writes (E.4); empty when it never ran.
    ReadRegStr $R0 HKCU "Software\OverwolfElectron" "MUID"
    ReadRegStr $R1 HKCU "Software\OverwolfPersist" "MUIDV2"
    ; Counter @COUNTER_NAME@ (App Uninstalls). NSIS has no HTTPS client of
    ; its own: use curl.exe (Windows 10 1803 and later), else PowerShell.
    StrCpy $R2 "@COUNTER_URL_PREFIX@&MUID=$R0&MUIDV2=$R1&Extra=@EXTRA@"
    ${If} ${FileExists} "$SYSDIR\curl.exe"
      nsExec::Exec '"$SYSDIR\curl.exe" -s -o NUL -m 5 "$R2"'
    ${Else}
      nsExec::Exec 'powershell.exe -NoProfile -NonInteractive -Command "try { Invoke-WebRequest -UseBasicParsing -TimeoutSec 5 -Uri $\'$R2$\' | Out-Null } catch {}"'
    ${EndIf}
    Pop $R2

    ; Overwolf's elevated helper is not removed: no package runtime installs
    ; it while ow-tauri hosts only the ads system (CONTRACT H).
  ${EndIf}
!macroend

!endif
