{
  "name": "ow-tauri",
  "version": "0.1.0",
  "description": "JavaScript host runtime for ow-tauri: app.overwolf, an Electron-compatible subset and the <owadview> element on Tauri 2.",
  "license": "MIT",
  "author": "ow-tauri contributors",
  "type": "module",
  "sideEffects": [
    "./dist/bootstrap/*.js",
    "./dist/electron/*.js",
    "./dist/main/*.js",
    "./dist/renderer/*.js"
  ],
  "exports": {
    "./main": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main/index.js",
      "default": "./dist/main/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js",
      "default": "./dist/electron/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "default": "./dist/renderer/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "main": [
        "./dist/main/index.d.ts"
      ],
      "electron": [
        "./dist/electron/index.d.ts"
      ],
      "renderer": [
        "./dist/renderer/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "build:injected": "rolldown -c rolldown.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "docs": "typedoc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@overwolf/ow-electron-packages-types": "^1.1.12"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/api": "2.12.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "rolldown": "1.2.12",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
