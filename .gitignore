# Rust
/target/
**/src-tauri/target/
**/src-tauri/gen/schemas/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.vitest/
/packages/*/docs-out/

# Lab output (headless runs write evidence here; never commit it)
/lab/out/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# Local env files (Overwolf dev-mode credentials live here, never in git)
.env
.env.*
!.env.example

# Parity harness: local installs, captures and the local app identity
/tools/parity-harness/node_modules/
/tools/parity-harness/captures/
/tools/parity-harness/local.identity.json

# Ad showcase: staged builds (they can hold the local identity), the local
# identity itself, lab output and generated Tauri files
/examples/ad-showcase/.stage/
/examples/ad-showcase/identity.local.json
/examples/ad-showcase/e2e/out/
/examples/ad-showcase/src-tauri/gen/
/examples/ad-showcase/src-tauri/windows/hooks.nsh

# npm pack output (the install steps pack the npm packages in a clone)
*.tgz

# Editors and local tools (the quickstart examples track .vscode/extensions.json)
.vscode/*
!.vscode/extensions.json
.claude/
.idea/
*.swp
