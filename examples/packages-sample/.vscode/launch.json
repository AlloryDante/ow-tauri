{
  // ow-tauri port of the upstream launch configurations.
  // Dev-mode credentials go in your environment or a local .env, never here.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ow-tauri: App (test ads)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start-ad"],
      "cwd": "${workspaceFolder}",
      "outputCapture": "std",
      "env": {
        // Windows: WebView2 remote debugging for every app webview
        // (added to the plugin's shared browser arguments, CONTRACT A.1.1).
        "OW_TAURI_REMOTE_DEBUGGING_PORT": "9222"
      }
    },
    {
      "name": "ow-tauri: Webviews (Windows, WebView2)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/dist",
      "timeout": 30000
    },
    {
      "name": "ow-tauri: Rust (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--manifest-path=./src-tauri/Cargo.toml"]
      },
      "args": ["--test-ad"],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "ow-tauri: All (Windows)",
      "configurations": ["ow-tauri: App (test ads)", "ow-tauri: Webviews (Windows, WebView2)"]
    }
  ]
}
