# Optional variables, read from the environment (never commit values).
# Dev-mode package credentials (debug builds only; kept for a future package runtime)
OW_CLI_EMAIL=
OW_CLI_API_KEY=
OW_DEV_KEY=
# Signing (`ow-tauri sign`, run by `npm run build:ow-tauri`)
OW_BUILD_KEY=
OW_CLI_API_URL=
OW_REQUIRE_SIGNING=
# Runtime switches
OW_TAURI_TEST_AD=
OW_TAURI_REMOTE_DEBUGGING_PORT=
