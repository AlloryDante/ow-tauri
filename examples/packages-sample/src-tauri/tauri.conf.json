{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overwolf Electron Official Sample App",
  "version": "1.0.0",
  "identifier": "dev.ow-tauri.packages-sample",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright 2026 Overwolf Ltd.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "overwolf": {
      "main": {
        "url": "browser/main.html"
      },
      "fs": {
        "scope": ["$PICTURES/Overwolf/$APPNAME", "$VIDEOS/$APPNAME"]
      }
    }
  }
}
