{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My React Game App",
  "version": "1.0.0",
  "identifier": "com.example.myreactgameapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "My React Game App", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-ancestors 'self'"
    }
  },
  "bundle": { "active": true },
  "plugins": {
    "overwolf": {
      "author": "Example Studio",
      "name": "My React Game App",
      "ads": { "testAd": true }
    }
  }
}
