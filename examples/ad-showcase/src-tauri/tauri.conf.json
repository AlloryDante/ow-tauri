{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ow-tauri Ad Showcase",
  "version": "1.0.0",
  "identifier": "dev.ow-tauri.ad-showcase",
  "build": {
    "beforeDevCommand": { "script": "node scripts/stage.mjs --host tauri", "wait": true },
    "beforeBuildCommand": "node scripts/stage.mjs --host tauri",
    "frontendDist": "../.stage/tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright 2026 ow-tauri contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "overwolf": {
      "author": "Example Studio",
      "name": "ow-tauri Ad Showcase"
    }
  }
}
